+}
+
+.figma-navbar__canvas {
+  z-index: 2;
+}
+
+.figma-navbar__toggle,
+.figma-navbar__backdrop {
+  display: none;
+}
+
+.figma-navbar__brand:focus-visible,
+.figma-navbar__link:focus-visible,
+.figma-navbar__guidebook:focus-visible,
+.figma-navbar__toggle:focus-visible {
+  outline: 3px solid #ffd900;
+  outline-offset: 3px;
+}
+
+.figma-navbar__guidebook.is-active {
