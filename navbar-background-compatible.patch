+    background: rgba(104, 90, 187, 0.2);
+    color: #ffffff;
+    cursor: pointer;
+  }
+
+  .figma-navbar__toggle span {
+    display: block;
+    width: 100%;
+    height: 3px;
+    border-radius: 999px;
+    background: currentColor;
+    transition:
+      transform 180ms ease,
+      opacity 180ms ease;
+  }
+
+  .figma-navbar__toggle[aria-expanded="true"] span:nth-child(1) {
+    transform: translateY(9.5px) rotate(45deg);
+  }
+
+  .figma-navbar__toggle[aria-expanded="true"] span:nth-child(2) {
+    opacity: 0;
+  }
+
+  .figma-navbar__toggle[aria-expanded="true"] span:nth-child(3) {
+    transform: translateY(-9.5px) rotate(-45deg);
+  }
+
+  .figma-navbar__backdrop {
+    position: fixed;
+    inset: 76px 0 0;
+    z-index: 1;
+    display: block;
+    padding: 0;
+    border: 0;
+    background: rgba(13, 18, 21, 0.62);
