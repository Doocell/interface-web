+.figma-navbar {
+  height: 76px;
+  background: #26353c;
+  border-bottom: 0;
+}
+
+.figma-navbar__background {
+  position: absolute;
+  top: 0;
+  left: 0;
+  z-index: 0;
+  width: 100%;
+  height: 78px;
+  max-width: none;
