+    position: absolute;
+    top: 14px;
+    right: 24px;
+    z-index: 40;
+    display: flex;
+    width: 48px;
+    height: 48px;
+    padding: 12px 10px;
+    flex-direction: column;
+    justify-content: space-between;
+    border: 1px solid rgba(255, 255, 255, 0.72);
